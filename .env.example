# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up --build`. Nothing here is a real secret.

# --- Postgres ---
POSTGRES_DB=pharmadocs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- JWT (backend) ---
# Must be at least 32 characters.
JWT_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=PharmaDocs.API
JWT_AUDIENCE=PharmaDocs.Client
JWT_EXPIRY_MINUTES=60

# --- Backend runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# --- Frontend (Next.js) ---
# Build-time only — baked into the client bundle, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://api:8080
WEB_PORT=3000
NODE_ENV=production
# Set to "true" once the app is served over HTTPS (e.g. Cloud Run).
COOKIE_SECURE=false
